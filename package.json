{
  "name": "aurora-fm",
  "version": "1.0.0",
  "description": "Aurora FM - 全球免费电台客户端",
  "main": "main.js",
  "author": "AuroraFM",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "icons": "bash scripts/generate-electron-icons.sh",
    "dist:mac": "npm run build && npm run icons && electron-builder --mac",
    "ios:unsigned": "bash build-ios-unsigned-ipa.sh",
    "ios:sim": "bash build-ios-simulator.sh"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "js-md5": "^0.11.0",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.aurora.fm",
    "productName": "AuroraFM",
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "icon": "build/icon.icns",
      "identity": null,
      "category": "public.app-category.music"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "mini.html",
      "style.css",
      "dist/**",
      "mqtt-client.js",
      "node_modules/ws/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "AuroraFM-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "artifactName": "AuroraFM-Setup-${version}.exe",
      "shortcutName": "Aurora FM"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  }
}
